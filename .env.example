# --- open-weight model (local) ---
OVERTURN_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1     # llama.cpp llama-server / vLLM / LM Studio
# --- sponsors / optional ---
# PRIORLABS_API_KEY=            # TabPFN. Only de-identified tabular features are sent.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overturn   # Tiger Data / pgvector
# SENTRY_DSN=
# TEMPORAL_ADDRESS=localhost:7233
# --- economics shown in the triage panel ---
OVERTURN_COST_APPEAL=85
OVERTURN_COST_RECODE=22

# Optional: Temporal (local: `temporal server start-dev`; Cloud: also set TEMPORAL_API_KEY + TEMPORAL_NAMESPACE)
# TEMPORAL_ADDRESS=localhost:7233
# Optional: Tiger Cloud / Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Optional: Backboard model arena (key stays in env; never committed)
# BACKBOARD_API_KEY=

# Optional: Tinker fine-tuning (see docs/TINKER.md)
# TINKER_API_KEY=
# TINKER_BASE_MODEL=Qwen/Qwen3.5-4B
# TINKER_MODEL_PATH=tinker://...
